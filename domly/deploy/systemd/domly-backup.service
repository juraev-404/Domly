[Unit]
Description=Back up Domly PostgreSQL and uploaded media
After=postgresql.service

[Service]
Type=oneshot
User=domly
Group=domly
WorkingDirectory=/srv/domly/repo/domly
EnvironmentFile=/etc/domly/domly.env
ExecStart=/srv/domly/repo/domly/scripts/backup.sh
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/domly
