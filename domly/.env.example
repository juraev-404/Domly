# Select production settings in systemd, not in local development.
DJANGO_SETTINGS_MODULE=domly.settings_prod
DJANGO_SECRET_KEY=replace-with-a-new-random-production-secret
DJANGO_ALLOWED_HOSTS=domly.site,www.domly.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://domly.site,https://www.domly.site
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

POSTGRES_DB=domly
POSTGRES_USER=domly
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/1

EMAIL_HOST=smtp.provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="Domly <no-reply@domly.site>"
SERVER_EMAIL="Domly server <server@domly.site>"

LEGAL_CONTACT_EMAIL=support@domly.site
# These neutral values are safe while Domly is operated without a registered
# business. Replace them only with truthful public details when they exist.
LEGAL_OPERATOR_NAME="Администратор сервиса Domly"
LEGAL_OPERATOR_ADDRESS="Республика Таджикистан"
LEGAL_OPERATOR_REGISTRATION_ID=
LEGAL_OPERATOR_TAX_ID=
LEGAL_DATA_PROTECTION_CERTIFICATE=

GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT="Domly/1.0 (support@domly.site)"
GEOCODER_TIMEOUT=5
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=900
DOMLY_BACKUP_RETENTION_DAYS=14
